# Copy to .env to enable LLM-as-a-Judge and LLM generation.
# WITHOUT this file the project still runs end-to-end in deterministic local mode.
OPENAI_API_KEY=
EVAL_MODEL=gpt-4o-mini

# "auto"  -> use the LLM if a key exists, otherwise fall back to the local judge
# "local" -> always use the deterministic local judge/generator
# "openai"-> require the LLM (fails loudly if the key is missing)
EVAL_MODE=auto
