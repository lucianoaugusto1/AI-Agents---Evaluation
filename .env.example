# Langfuse observability.
# Local evals run without these values, but Langfuse tracing needs them.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Real agent runtime with Agno + Groq.
# Keep "scripted" for the deterministic workshop baseline.
ACME_AGENT_RUNTIME=scripted
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
