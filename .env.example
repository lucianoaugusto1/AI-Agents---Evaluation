# Langfuse observability.
# Local evals run without these values, but Langfuse tracing needs them.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Real agent runtime with Agno + Groq.
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.6-27b

# Modelo do LLM-as-a-Judge. O rate limit da Groq e por modelo, e a suite faz
# duas chamadas de juiz por caso: usar um modelo diferente do gerador divide a
# cota em dois buckets e a suite completa deixa de esperar tanto.
# Juiz e gerador diferentes tambem reduzem o vies de o modelo avaliar a si mesmo.
JUDGE_MODEL=qwen/qwen3.8-27b
